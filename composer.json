{
    "name": "tusk/app",
    "description": "A starting project for applications built with Tusk Framework",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "tusk-framework/framework": "^0.3.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml"
    }
}
